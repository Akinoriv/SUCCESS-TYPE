generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite" // Change to "postgresql" for Railway
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  email           String?
  age             Int?
  gender          String?
  profileData     Json? 
  createdAt       DateTime        @default(now())
  quizSessions    QuizSession[]
  purchases       Purchase[]
  userAssignments UserAssignment[]
  @@map("users")
}

model QuizSession {
  id              String       @id @default(uuid())
  userId          String
  quizId          String
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  ipAddress       String?
  
  // Landing tracking
  landingCategory String?      // "courses", "career", "general"
  landingVariant  String?      // "courses-a", "courses-b", etc.
  utmSource       String?      // utm_source
  utmMedium       String?      // utm_medium
  utmCampaign     String?      // utm_campaign
  
  user            User         @relation(fields: [userId], references: [id])
  answers         TestAnswer[]
  result          QuizResult?
  
  @@index([landingCategory])
  @@index([landingVariant])
  @@map("quiz_sessions")
}

model QuizResult {
  id                   String      @id @default(uuid())
  sessionId            String      @unique
  resultType           String
  resultData           Json
  satisfactionScore    Int?
  satisfactionFeedback String?
  createdAt            DateTime    @default(now())
  session              QuizSession @relation(fields: [sessionId], references: [id])
  purchases            Purchase[]
  @@map("quiz_results")
}

model TestAnswer {
  id         String      @id @default(uuid())
  sessionId  String
  questionId String
  answer     String
  timestamp  DateTime    @default(now())
  session    QuizSession @relation(fields: [sessionId], references: [id])
  @@map("test_answers")
}

model Purchase {
  id            String     @id @default(uuid())
  userId        String
  resultId      String
  amount        Float
  paymentId     String     @unique
  paymentStatus String     @default("pending")
  gateway       String     @default("yookassa")
  paymentData   Json?
  createdAt     DateTime   @default(now())
  purchasedAt   DateTime?
  user          User       @relation(fields: [userId], references: [id])
  result        QuizResult @relation(fields: [resultId], references: [id])
  @@map("purchases")
}

model LandingVariant {
  id              String           @id @default(uuid())
  category        String           // "courses", "career", "general"
  name            String           // "Courses - Вариант A"
  slug            String           @unique // "courses-a"
  contentJson     Json             // Hero, painPoints, CTA, colors, SEO
  isActive        Boolean          @default(true)
  trafficSplit    Int              @default(50) // % трафика для A/B теста
  views           Int              @default(0)
  conversions     Int              @default(0)
  createdAt       DateTime         @default(now())
  userAssignments UserAssignment[]
  
  @@unique([category, slug])
  @@index([category, isActive])
  @@map("landing_variants")
}

model UserAssignment {
  id         String         @id @default(uuid())
  userId     String
  variantId  String
  assignedAt DateTime       @default(now())
  converted  Boolean        @default(false)
  user       User           @relation(fields: [userId], references: [id])
  variant    LandingVariant @relation(fields: [variantId], references: [id])
  @@unique([userId, variantId])
  @@map("user_assignments")
}

model Question {
  id          String   @id @default(uuid())
  order       Int      @unique
  textDefault String
  variations  Json     // { "default": "текст", "male": "текст для мужчин", "female": "текст для женщин" }
  type        String   // "choice" или "scale"
  options     Json     // { "A": { "text": "текст", "score": 1 }, "Б": {...} } или { "min": 1, "max": 10 }
  dimension   String   // "energy" или "focus"
  createdAt   DateTime @default(now())
  @@map("questions")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  sessionId String?
  variantId String?
  eventData Json?
  timestamp DateTime @default(now())
  @@index([eventType, timestamp])
  @@index([variantId, timestamp])
  @@map("analytics_events")
}

